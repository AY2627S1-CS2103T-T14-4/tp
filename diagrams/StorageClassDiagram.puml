@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor STORAGE_COLOR
skinparam classBackgroundColor STORAGE_COLOR

package Storage as StoragePackage {

Class "<<interface>>\nStorage" as Storage
Class StorageManager

package "UserPrefs Storage" #F4F6F6{
Class JsonUserPrefsStorage
}

package "PawPals Storage" #F4F6F6{
Class JsonPawPalsStorage
Class JsonSerializablePawPals
Class JsonAdaptedClient
Class JsonAdaptedTag
Class JsonAdaptedPet
Class JsonAdaptedAppointment
Class JsonAdaptedCompletedSession
}

}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Storage

StorageManager .up.|> Storage
StorageManager -down-> "1" JsonUserPrefsStorage
StorageManager -down-> "1" JsonPawPalsStorage

JsonPawPalsStorage ..> JsonSerializablePawPals
JsonSerializablePawPals --> "*" JsonAdaptedClient
JsonAdaptedClient --> "*" JsonAdaptedTag
JsonAdaptedClient --> "*" JsonAdaptedPet
JsonAdaptedClient --> "*" JsonAdaptedAppointment
JsonAdaptedClient --> "*" JsonAdaptedCompletedSession
JsonAdaptedCompletedSession --> "1" JsonAdaptedAppointment : snapshot >

@enduml
