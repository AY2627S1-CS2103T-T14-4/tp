@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
participant ":VersionedPawPals" as VersionedPawPals MODEL_COLOR
end box

[-> Model : undoPawPals()
activate Model

Model -> VersionedPawPals : undo()
activate VersionedPawPals

VersionedPawPals -> VersionedPawPals :resetData(ReadOnlyPawPals)
VersionedPawPals --> Model :
deactivate VersionedPawPals

[<-- Model
deactivate Model

@enduml
