<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" minWidth="0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane minWidth="0" HBox.hgrow="ALWAYS">
    <columnConstraints>
      <ColumnConstraints hgrow="ALWAYS" minWidth="0" />
    </columnConstraints>
    <VBox alignment="CENTER_LEFT" minWidth="0" minHeight="105" GridPane.columnIndex="0">
      <padding>
        <Insets top="5" right="5" bottom="5" left="15" />
      </padding>
      <HBox spacing="0.5" alignment="CENTER_LEFT">
        <Label fx:id="id" styleClass="cell_big_label">
          <minWidth>
            <!-- Ensures that the label text is never truncated -->
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
        </Label>
        <Label fx:id="name" text="\$first" styleClass="cell_big_label" />
      </HBox>
      <FlowPane fx:id="tags" />
      <Label fx:id="phone" styleClass="cell_small_label" text="\$phone" />
      <Label fx:id="address" styleClass="cell_small_label" text="\$address"
             wrapText="true" minWidth="0" minHeight="-Infinity" maxWidth="Infinity" />
      <Label fx:id="email" styleClass="cell_small_label" text="\$email" />
      <VBox fx:id="pets" minWidth="0" />
      <VBox fx:id="appointments" minWidth="0" />
      <Label text="History" styleClass="cell_small_label" />
      <Label fx:id="emptyHistory" text="No completed sessions" styleClass="empty-state"
             wrapText="true" minWidth="0" minHeight="-Infinity" maxWidth="Infinity" />
      <VBox fx:id="history" minWidth="0" spacing="5" />
    </VBox>
  </GridPane>
</HBox>
